# ──────────────────────────────────────────────────────────────
# BitFox — Quick-Start .env for Docker
# Copy to parent dir or set these in Portainer stack env vars.
# ──────────────────────────────────────────────────────────────

# === REQUIRED ===
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# === BOT CONFIG (change per instance) ===
STRATEGY=Phoenix        # Options: Phoenix, SuperTrend, SuperTrendFull, RSITrend, EmaTrend
SYMBOL=ADAUSDT
TIMEFRAME=1h
AMOUNT=50

# === NOTIFICATIONS (optional) ===
NOTIFICATION_TYPE=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
NTFY_TOPIC=
NTFY_ADDRESS=

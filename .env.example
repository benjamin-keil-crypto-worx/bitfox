BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# DonchianTrend is the only strategy here with a positive walk-forward out-of-sample result
# (pooled OOS PF 1.46 over 334 trades). It is a DAILY trend-following strategy: expect roughly
# 8-12 trades per year, a ~30% win rate, and most of the return coming from a few large winners.
# Read BENCHMARKS.md — including its known weakness — before running it with real money.
SYMBOL=BTCUSDT
TIMEFRAME=1d
STRATEGY=DonchianTrend

# Fixed position size in base units. Used when risk sizing below is not configured.
AMOUNT=50

# Risk-based position sizing (recommended for DonchianTrend). BOTH must be set or the bot falls
# back to the fixed AMOUNT above. RISK_PCT is the fraction of EQUITY risked per trade (0.01 = 1%);
# EQUITY is your account size in quote currency (USDT).
# This matters more than it sounds: on the research data the same trades produced a 63% median
# drawdown at fixed size versus 20% when risk-sized.
RISK_PCT=0.01
EQUITY=1000

NOTIFICATION_TYPE=telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional
SLACK_WEBHOOK_URL=
EMAIL_FROM=
EMAIL_TO=
NTFY_TOPIC=
NTFY_ADDRESS=
